location /zhe-public/ff-ext-signed/ {

    if (-f /data/zhe-monitor/maintenance-status) {
        return 503;
    }

    limit_except GET {
        deny all;
    }

    set $s3_host ${IMAGES_BUCKET_NAME}.${BUCKET_DOMAIN};
    set $s3_location /zhe-public/ff-ext-signed/;
    set $s3_key_prefix ${FIREFOX_EXT_S3_BUCKET_DIR}/;
    if ($s3_uri = '') {
        return 403;
    }

    proxy_cache my_image_cache;
    proxy_cache_revalidate on;
    proxy_cache_min_uses 3;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;

    proxy_method GET;
    proxy_pass https://bucket-images$s3_uri;

    proxy_http_version     1.1;
    proxy_redirect         off;
    proxy_set_header       Connection "";
    proxy_set_header       Authorization $s3_authorization;
    proxy_set_header       x-amz-date $s3_amz_date;
    proxy_set_header       x-amz-content-sha256 $s3_content_sha256;
    proxy_set_header       Host $s3_host;
    proxy_set_header       X-Real-IP $remote_addr;
    proxy_set_header       X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_hide_header      Set-Cookie;
    proxy_ignore_headers   Set-Cookie;
    proxy_intercept_errors on;

    proxy_set_header        X-NginX-Proxy true;
    proxy_set_header        Upgrade $http_upgrade;
    proxy_set_header        Connection "upgrade";

    proxy_ssl_verify        off;
    proxy_ssl_server_name   on;

    add_header              Content-Type "application/x-xpinstall";

}
